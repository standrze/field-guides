{
  "model": "google/gemma-3-27b-pt",
  "revision": "main",
  "objective": "cpt",
  "train_file": "../examples/cpt-train.jsonl",
  "eval_file": "../examples/cpt-eval.jsonl",
  "output_dir": "../runs/cpt",
  "max_length": 2048,
  "learning_rate": 5e-05,
  "epochs": 1,
  "micro_batch": 1,
  "gradient_accumulation": 16,
  "rank": 16,
  "alpha": 32,
  "dropout": 0.05,
  "weight_decay": 0.01,
  "warmup_ratio": 0.03,
  "eval_steps": 50,
  "save_steps": 50,
  "seed": 42
}
